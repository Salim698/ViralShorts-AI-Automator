{
    "name": "Integration Webhooks, Facebook Pages",
    "flow": [
        {
            "id": 1,
            "module": "gateway:CustomWebHook",
            "version": 1,
            "parameters": {
                "hook": null,
                "maxResults": 1
            },
            "mapper": {},
            "metadata": {
                "designer": {
                    "x": -137,
                    "y": -5
                },
                "restore": {
                    "parameters": {
                        "hook": {
                            "data": {
                                "editable": "true"
                            },
                            "label": "n8n_to_facebook_webhook"
                        }
                    }
                },
                "parameters": [
                    {
                        "name": "hook",
                        "type": "hook:gateway-webhook",
                        "label": "Webhook",
                        "required": true
                    },
                    {
                        "name": "maxResults",
                        "type": "number",
                        "label": "Maximum number of results"
                    }
                ],
                "interface": [
                    {
                        "name": "video_url",
                        "type": "text"
                    },
                    {
                        "name": "title",
                        "type": "text"
                    },
                    {
                        "name": "description",
                        "type": "text"
                    }
                ]
            }
        },
        {
            "id": 2,
            "module": "facebook-pages:UploadVideo",
            "version": 6,
            "parameters": {
                "__IMTCONN__": null
            },
            "mapper": {
                "url": "{{1.video_url}}",
                "type": "url",
                "page_id": "YOUR_FACEBOOK_PAGE_ID",
                "description": "{{1.description}}"
            },
            "metadata": {
                "designer": {
                    "x": 320,
                    "y": -8
                },
                "restore": {
                    "expect": {
                        "type": {
                            "mode": "chose",
                            "label": "download a video from URL"
                        },
                        "page_id": {
                            "mode": "chose",
                            "label": "Votre Page Facebook"
                        }
                    },
                    "parameters": {
                        "__IMTCONN__": {
                            "data": {
                                "scoped": "true",
                                "connection": "facebook"
                            },
                            "label": "Connexion Facebook Automatisée"
                        }
                    }
                },
                "parameters": [
                    {
                        "name": "__IMTCONN__",
                        "type": "account:facebook",
                        "label": "Connection",
                        "required": true
                    }
                ],
                "expect": [
                    {
                        "name": "page_id",
                        "type": "select",
                        "label": "Page",
                        "required": true
                    },
                    {
                        "name": "type",
                        "type": "select",
                        "label": "Type",
                        "required": true,
                        "validate": {
                            "enum": [
                                "data",
                                "url"
                            ]
                        }
                    },
                    {
                        "name": "description",
                        "type": "text",
                        "label": "Video caption"
                    },
                    {
                        "name": "url",
                        "type": "url",
                        "label": "URL",
                        "required": true
                    }
                ]
            }
        }
    ],
    "metadata": {
        "instant": true,
        "version": 1,
        "scenario": {
            "roundtrips": 1,
            "maxErrors": 3,
            "autoCommit": true,
            "autoCommitTriggerLast": true,
            "sequential": false,
            "slots": null,
            "confidential": false,
            "dataloss": false,
            "dlq": false,
            "freshVariables": false
        },
        "designer": {
            "orphans": []
        },
        "zone": "eu1.make.com",
        "notes": []
    }
}
