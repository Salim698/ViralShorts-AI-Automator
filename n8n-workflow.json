    {
      "parameters": {
        "jsCode": "const emotion = ($('Parser Gemini').first().json.emotion || '').toLowerCase();\n// Fallback links, can be updated in environment or external DB\nconst fallback = [\"https://www.dropbox.com/scl/fi/vmjxl6ib7hgux2d9nofr3/atlasaudio-motivation-on-519559.mp3?rlkey=8myal9cm7rgmp6cnr228dps5x&st=81pf9tpb&dl=1\"];\nconst lienDirect = fallback[0];\n\nconst previousData = $input.first().json;\n\nreturn [{\n  json: {\n    ...previousData,\n    url_musique: lienDirect,\n    emotion_detected: emotion\n  }\n}];"
