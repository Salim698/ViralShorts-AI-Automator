    {
      "parameters": {
        "jsCode": "const job = $json.data;\n\nif (!job) {\n  throw new Error('Réponse CloudConvert invalide: ' + JSON.stringify($json).substring(0, 200));\n}\n\nif (job.status === 'error') {\n  throw new Error('Erreur CloudConvert: ' + JSON.stringify(job.tasks?.map(t => t.message)).substring(0, 300));\n}\n\nif (job.status !== 'finished') {\n  throw new Error('Job pas encore terminé (statut: ' + job.status + '). Augmente le délai dans le noeud Attendre Rendu.');\n}\n\nconst exportTask = job.tasks?.find(t => t.operation === 'export/url' && t.status === 'finished');\nif (!exportTask \vert{}\vert{} !exportTask.result?.files?.[0]?.url) {\n  throw new Error('Tâche export non trouvée.');\n}\n\nconst prevData = $('Extraire Job ID').first().json;\n\nreturn [{\n  json: {\n    download_url: exportTask.result.files[0].url,\n    filename: exportTask.result.files[0].filename,\n    title: prevData.title,\n    hashtags: prevData.hashtags\n  }\n}];"
