      "parameters": {
        "jsCode": "const txt = $input.first().json.candidates[0].content.parts[0].text;\n\nconst clean = txt\n  .replace(/```json/gi, '')\n  .replace(/```/g, '')\n  .replace(/\\n/g, ' ')\n  .trim();\n\nlet parsed;\n\ntry {\n  parsed = JSON.parse(clean);\n} catch (e) {\n  const match = clean.match(/\\{[\\s\\S]*\\}/);\n\n  if (match) {\n    try {\n      parsed = JSON.parse(match[0]);\n    } catch {\n      throw new Error('Gemini JSON invalide: ' + clean.substring(0, 300));\n    }\n  } else {\n    throw new Error('Aucun JSON trouvé: ' + clean.substring(0, 300));\n  }\n}\n\nreturn [\n  {\n    json: parsed\n  }\n];"
      },
