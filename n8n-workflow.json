    {
      "parameters": {
        "jsCode": "const FALLBACK_VIDEO = \"https://videos.pexels.com/video-files/856953/856953-hd_1920_1080_30fps.mp4\";\n\nfunction getSafeLink(videoObj) {\n  if (!videoObj?.video_files?.length) return FALLBACK_VIDEO;\n  const files = videoObj.video_files;\n  let best = files.find(f => f.width === 1080 && f.height === 1920);\n  if (!best) best = files.find(f => f.height > f.width && f.quality === 'hd');\n  if (!best) best = files.find(f => f.quality === 'hd');\n  if (!best) best = files.find(f => f.link?.includes('.mp4'));\n  return best?.link || FALLBACK_VIDEO;\n}\n\nconst parser = $('Parser Gemini').first().json;\n\nconst segmentVideos = items.map(item => {\n  const videos = item.json.videos || [];\n  const shuffled = [...videos].sort(() => Math.random() - 0.5);\n  const segment = item.json;\n  return {\n    line: segment.line || \"\",\n    visual: segment.visual || \"\",\n    duration: segment.duration || 4,\n    video_url: getSafeLink(shuffled[0])\n  };\n});\n\nreturn [{\n  json: {\n    title: parser.title,\n    script: parser.script,\n    hook: parser.hook,\n    emotion: parser.emotion,\n    hashtags: parser.hashtags,\n    segments: segmentVideos\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1280,
        1760
      ],
      "id": "068b8af6-8eeb-4d89-a0a3-d5fb16eb751c",
      "name": "Extract URL vidéo SEGMENTS",
      "retryOnFail": true
    },
    {
      "parameters": {
        "mode": "combine",
        "combineBy": "combineByPosition",
        "options": {}
      },
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
        1600,
        1568
      ],
      "id": "c8832406-34d3-4440-be33-610b9992ccc3",
      "name": "Merge"
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst audioBase64 = data.audio_base64;\nconst urlMusique = data.url_musique;\nconst hookSafe = data.hook_safe;\nconst segments = data.segments;\n\nif (!segments || !audioBase64) throw new Error(\"Erreur Merge.\");\n\nconst tasks = {};\ntasks[\"import-audio\"] = { \"operation\": \"import/base64\", \"file\": audioBase64, \"filename\": \"audio.mp3\" };\ntasks[\"import-music\"] = { \"operation\": \"import/url\", \"url\": urlMusique, \"filename\": \"music.mp3\" };\n\nconst inputTasks = [];\nsegments.forEach((seg, index) => {\n  const taskName = `import-v${index + 1}`;\n  tasks[taskName] = { \"operation\": \"import/url\", \"url\": seg.video_url, \"filename\": `v${index + 1}.mp4` };\n  inputTasks.push(taskName);\n});\n\nlet ffmpegArgs = \"\";\nsegments.forEach((seg, index) => { ffmpegArgs += `-stream_loop 15 -i /input/import-v${index + 1}/v${index + 1}.mp4 `; });\nffmpegArgs += `-i /input/import-audio/audio.mp3 -i /input/import-music/music.mp3 `;\n\nlet filterComplex = \"\";\nlet concatInputs = \"\";\nsegments.forEach((seg, index) => {\n  let duration = seg.duration || 5; \n  if (index === segments.length - 1) duration += 30;\n  filterComplex += `[${index}:v]scale=1080:1920:force_original_aspect_ratio=increase,crop=1080:1920,fps=30,setsar=1,trim=duration=${duration},setpts=PTS-STARTPTS[v${index + 1}];`;\n  concatInputs += `[v${index + 1}]`;\n});\n\nconst audioIndex = segments.length;\nconst musicIndex = segments.length + 1;\nfilterComplex += `[${audioIndex}:a]aresample=44100[voice];[${musicIndex}:a]volume=0.08[bg];[voice][bg]amix=inputs=2:duration=first[audio];${concatInputs}concat=n=${segments.length}:v=1:a=0[video];[video]drawtext=text='${hookSafe}':fontcolor=white:fontsize=60:x=(w-text_w)/2:y=(h*0.10):box=1:boxcolor=black@0.45:boxborderw=20[v]`;\n\nffmpegArgs += `-filter_complex \"${filterComplex}\" -map \"[v]\" -map \"[audio]\" -c:v libx264 -preset fast -crf 22 -pix_fmt yuv420p -c:a aac -b:a 192k -shortest /output/video_finale.mp4`;\n\ntasks[\"merge-av\"] = { \"operation\": \"command\", \"engine\": \"ffmpeg\", \"input\": [...inputTasks, \"import-audio\", \"import-music\"], \"command\": \"ffmpeg\", \"arguments\": ffmpegArgs };\ntasks[\"export\"] = { \"operation\": \"export/url\", \"input\": \"merge-av\", \"inline\": false, \"archive_multiple_files\": false };\n\nreturn [{ json: { cloudconvert_payload: { tasks } } }];"
      },
